WORKBENCH_HOST_TOKEN=<32+ random chars, shared with the work bot>
WORKBENCH_DASHBOARD_TOKEN=<separate random password for the read-only page>
WORKBENCH_DASHBOARD_WORKSPACE=work
WORKBENCH_DASHBOARD_PRINCIPAL=owner
# The owner in person: signing in to the dashboard with this token adds the owner's write forms.
WORKBENCH_OWNER_TOKEN=
# The owner's companion agent (Xiyue): task tools only, as its own bot id (bind it to the owner with bind-identity).
WORKBENCH_COMPANION_TOKEN=
WORKBENCH_COMPANION_BOT_ID=xiyue
# What the household calls its assistant (panel bar, source labels). Default 助手.
WORKBENCH_ASSISTANT_NAME=

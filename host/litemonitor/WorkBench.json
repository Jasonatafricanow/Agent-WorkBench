{
  "id": "WorkBench",
  "meta": {
    "name": "工作台状态",
    "version": "1.0",
    "author": "Agent-WorkBench",
    "description": "只读显示 Agent-WorkBench 的当前焦点、待审批、逾期，以及 Agent Host 是否在线（workbench.status.v1）。不做任何写入或进程操作。",
    "url": "https://github.com/Jasonatafricanow/Agent-WorkBench"
  },
  "inputs": [
    {
      "key": "base_url",
      "label": "WorkBench 状态地址",
      "type": "text",
      "default": "http://127.0.0.1:8791",
      "placeholder": "http://<工作台主机>:8791",
      "scope": "global"
    },
    {
      "key": "status_token",
      "label": "只读状态 Token",
      "type": "password",
      "default": "",
      "placeholder": "WORKBENCH_STATUS_TOKEN",
      "scope": "global"
    }
  ],
  "execution": {
    "type": "chain",
    "interval": 30,
    "min_interval": 15,
    "steps": [
      {
        "id": "status",
        "url": "{{base_url}}/status/v1",
        "method": "GET",
        "headers": { "Authorization": "Bearer {{status_token}}" },
        "response_format": "json",
        "extract": {
          "line": "line",
          "level": "level",
          "host_state": "host_state",
          "approvals": "approvals",
          "overdue": "overdue"
        },
        "process": [
          {
            "var": "host_text",
            "source": "host_state",
            "function": "map",
            "map": { "0": "在线", "1": "迟到", "2": "离线" }
          }
        ]
      }
    ]
  },
  "outputs": [
    {
      "key": "summary",
      "label": "工作台",
      "short_label": "WB",
      "format_val": "{{line}}",
      "color": "{{level}}",
      "unit": ""
    },
    {
      "key": "host",
      "label": "Agent Host",
      "short_label": "Host",
      "format_val": "{{host_text}}",
      "color": "{{host_state}}",
      "unit": ""
    }
  ]
}

WORKBOT_TELEGRAM_TOKEN=<new bot token from BotFather, not the companion bot's>
WORKBOT_BOT_ID=workbot
WORKBOT_MODEL=xai/grok-4.7
WORKBENCH_HOST_TOKEN=<same as workbench.env>
WORKBENCH_WORKSPACE=work
WORKBOT_OWNER_PRINCIPAL=owner
WORKBOT_AGENT_EXTERNAL_ID=agent
# Agents this Host can run as (principal_id -> external id bound with provider "host"); used after handoffs
WORKBOT_AGENTS={"agent":"agent"}
# principal_id -> Telegram chat id for notifications
WORKBOT_RECIPIENT_CHATS={"owner":"<owner telegram id>"}
# Extra guarded tools (send_external_message is always guarded): tool -> {"action","task_from","conditions_from"}
WORKBOT_GUARDED_TOOLS={}
MRMEM_URL=http://127.0.0.1:8880
MRMEM_TOKEN=<MR-Mem token>
WORKBOT_MEMORY_SCOPE=workbench
